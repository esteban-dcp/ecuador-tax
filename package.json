{
  "name": "ecuador-tax-sdk",
  "private": true,
  "version": "0.0.0",
  "description": "Ecuador Tax SDK: herramientas modulares para facturación electrónica del SRI (Ecuador).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esteban-dcp/ecuador-tax.git"
  },
  "bugs": {
    "url": "https://github.com/esteban-dcp/ecuador-tax/issues"
  }
}
